# Copy to .env.production and keep the real file outside version control.
# Do not use development/default passwords in production.

POSTGRES_DB=autoparts
POSTGRES_USER=autoparts
POSTGRES_PASSWORD=CHANGE_TO_LONG_RANDOM_PASSWORD
# URL-encode the password below if it contains reserved URI characters.
DATABASE_URL=postgres://autoparts:CHANGE_TO_LONG_RANDOM_PASSWORD@postgres:5432/autoparts?sslmode=disable

KEYCLOAK_IMAGE=keycloak/keycloak:26.7.0
KEYCLOAK_DB_PASSWORD=CHANGE_TO_DIFFERENT_LONG_RANDOM_PASSWORD
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_TO_LONG_RANDOM_ADMIN_PASSWORD
# Public hostname/url as seen by browsers and JWT issuer validation.
KEYCLOAK_HOSTNAME=https://auth.example.com
KEYCLOAK_ISSUER=https://auth.example.com/realms/autoparts

APP_PUBLIC_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NEXT_PUBLIC_EDGE_INSTALLER_URL=https://downloads.example.com/AutoParts-Store-Agent-Setup.exe
ALLOWED_ORIGINS=https://app.example.com

# Host-only published ports; put a TLS reverse proxy/load balancer in front.
WEB_BIND_PORT=3000
API_BIND_PORT=8080
KEYCLOAK_BIND_PORT=8081

RATE_LIMIT_PER_MINUTE=600
PUBLIC_SEARCH_RATE_LIMIT_PER_MINUTE=120

APP_VERSION=0.15.0-rc.1
APP_COMMIT=unknown
APP_BUILD_TIME=unknown

GO_MODULE_PROXY=https://proxy.golang.org|https://goproxy.cn|direct
GO_SUMDB=sum.golang.google.cn
