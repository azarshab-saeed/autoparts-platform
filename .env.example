# PostgreSQL development password
POSTGRES_PASSWORD=autoparts

# Keycloak Admin Console: http://localhost:8081/admin

# Keycloak container image. Docker Hub is used by default to avoid quay.io connectivity issues.
KEYCLOAK_IMAGE=keycloak/keycloak:26.7.0
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-change-me

# Development password reconciled by keycloak-sync for seeded test users.
KEYCLOAK_DEV_PASSWORD=ChangeMe123!

# Optional Go module mirrors for restricted networks.
GO_MODULE_PROXY=https://proxy.golang.org|https://goproxy.cn|direct
GO_SUMDB=sum.golang.google.cn
