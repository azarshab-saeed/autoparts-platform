#!/bin/sh
set -eu
PACKAGED_DIR="${AUTOPARTS_EDGE_PACKAGED_DIR:-/usr/lib/autoparts-store-edge}"
BASE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/autoparts-store-edge"
RUNTIME_DIR="$BASE_DIR/bin"
DATA_DIR="$BASE_DIR/data"
LOG_DIR="$BASE_DIR/logs"
mkdir -p "$RUNTIME_DIR" "$DATA_DIR" "$LOG_DIR"
chmod 700 "$BASE_DIR" "$RUNTIME_DIR" "$DATA_DIR" 2>/dev/null || true

PACKAGED_VERSION=$(cat "$PACKAGED_DIR/VERSION" 2>/dev/null || printf '0')
RUNTIME_VERSION=0
if [ -x "$RUNTIME_DIR/autoparts-store-edge-manager" ]; then
  RUNTIME_VERSION=$($RUNTIME_DIR/autoparts-store-edge-manager --version 2>/dev/null || printf '0')
fi

refresh=false
if [ ! -x "$RUNTIME_DIR/autoparts-store-edge-manager" ] || [ ! -x "$RUNTIME_DIR/autoparts-store-edge" ] || [ ! -x "$RUNTIME_DIR/autoparts-store-edge-updater" ]; then
  refresh=true
elif command -v dpkg >/dev/null 2>&1 && dpkg --compare-versions "$PACKAGED_VERSION" gt "$RUNTIME_VERSION"; then
  refresh=true
fi

if [ "$refresh" = true ]; then
  install -m 0755 "$PACKAGED_DIR/autoparts-store-edge-manager" "$RUNTIME_DIR/autoparts-store-edge-manager"
  install -m 0755 "$PACKAGED_DIR/autoparts-store-edge" "$RUNTIME_DIR/autoparts-store-edge"
  install -m 0755 "$PACKAGED_DIR/autoparts-store-edge-updater" "$RUNTIME_DIR/autoparts-store-edge-updater"
fi

export AUTOPARTS_EDGE_DATA_DIR="$DATA_DIR"
export AUTOPARTS_EDGE_WORKER_PATH="$RUNTIME_DIR/autoparts-store-edge"
export AUTOPARTS_EDGE_UPDATER_PATH="$RUNTIME_DIR/autoparts-store-edge-updater"
export AUTOPARTS_EDGE_MANAGER_SERVICE=systemd-user
exec "$RUNTIME_DIR/autoparts-store-edge-manager" "$@"
